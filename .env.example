DB_MIGRATIONS_TABLE=historial_migraciones_ordenes
DB_URL=jdbc:postgresql://IP_PRIVADA_EC2_ORDENES:5432/talleres360
DB_USERNAME=t360_ordenes
# Genera una contraseña propia; no publiques el archivo .env.
DB_PASSWORD=
# Misma clave en los cinco microservicios, administradores y BFF.
INTERNAL_API_KEY=
# IP privadas de las EC2 correspondientes, sin /api ni /dev.
CATALOG_URL=http://IP_PRIVADA_EC2_CATALOGO:8082
REPORT_URL=http://IP_PRIVADA_EC2_REPORTES:8083
NOTIFICATIONS_URL=http://IP_PRIVADA_EC2_NOTIFICACIONES:8084
AUDIT_URL=http://IP_PRIVADA_EC2_AUDITORIA:8085
CORS_ALLOWED_ORIGINS=http://localhost:5173
# RabbitMQ para tareas; Catalogo, Reporteria y Auditoria usan HTTP con outbox durable.
# http es una alternativa local explícita, sin RabbitMQ.
MESSAGING_TRANSPORT=rabbit
RABBIT_ADDRESSES=IP_PRIVADA_EC2_MQ:5672,IP_PRIVADA_EC2_MQ:5673
RABBIT_USERNAME=talleres360
RABBIT_PASSWORD=
RABBIT_VHOST=/
